# Mouse for full-screen programs:  zig build run -- --script test/mouse.gt
# (keep the real mouse off gtty's window while it runs)
# mouse-1: test/mouse-read.sh asked for ?1002 + ?1006; its "got:" line
# holds a click (0;C;R M, then m), a drag (32;…M on the new cell, m), the
# wheel (64 up, 65 down) and a right click (2;…M / m); the Shift-click
# isn't there (it's gtty's). mouse-2: less in the same shell (alternate
# screen, no mouse mode): the wheel sent ↓ (3 lines a notch), line 7 is
# on top. mouse-3: printf left ?1000 on, the prompt mark turned it off: a
# drag selects text as usual (highlighted).
/s bash
/wait 1500
/type sh test/mouse-read.sh
/wait 600
/click 300 200
/drag 300 200 360 200
/wheel 300 200 1
/wheel 300 200 -1
/rclick 300 200
/mods shift
/click 400 200
/mods none
/wait 2600
/shot mouse-1.bmp
/click 300 400
/type seq 1 200 | less
/wait 800
/wheel 300 200 -2
/wait 500
/shot mouse-2.bmp
/text q
/wait 500
/type printf '\033[?1000h'
/wait 500
/drag 30 137 200 137
/wait 300
/shot mouse-3.bmp
/quit
