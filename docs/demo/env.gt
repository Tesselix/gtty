# Env & Aliases (the right-click menu of a shell window): where each
# variable and alias was set. EDITOR (vi in .zshenv, nvim in .zshrc),
# PATH (inherited, /etc/zprofile's path_helper, .zprofile, .zshrc) and the
# alias ll (.zshrc, then .aliases) are opened to show what they had before.
/resize 1200 760
/s
/wait 1800
/type clear
/wait 500
/move 600 300
/wait 300
/pace 250
/record start @FRAMES@ 20
/wait 300
/glide 420 300 400
/rclick 420 300
/wait 500
/glide 500 594 500
/click 500 594
/wait 300
/glide 1160 420 400
/wait 300
/slow editor
/wait 400
/key enter
/wait 1600
/key escape
/slow path
/wait 300
/key down
/wait 300
/key enter
/wait 2200
/key escape
/slow ll
/wait 300
/key down
/wait 300
/key enter
/wait 1800
/record stop
/quit
