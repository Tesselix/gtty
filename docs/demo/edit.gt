# Editing a long command (wrapped over two rows) with the mouse, as in a
# text field: double-click a word and type over it, drag over a word and
# delete it, click where the cursor should go; then run it.
/resize 1200 760
/s
/wait 1800
/type clear
/wait 500
/text git log --since='2 weeks ago' --author=demo --pretty=format:'%h  %ad  %s' --date=short -- src/ docs/ CHANGES | grep -v docs | head -5
/move 600 400
/wait 600
/pace 300
/record start @FRAMES@ 20
/wait 500
# double-click "weeks", type "days" over it
/glide 305 53 500
/dclick 305 53
/wait 400
/slow days
/wait 400
# drag over "docs/ ", delete it
/glide 1035 53 500
/drag 1035 53 1093 53
/wait 400
/key backspace
/wait 400
# a click past the line's end puts the cursor there: -5 → -3
/glide 600 75 500
/click 600 75
/wait 400
/key backspace
/slow 3
/wait 400
/key enter
/wait 1200
/record stop
/quit
