# README hero: three commands typed at the gtty prompt open three windows
# on one screen (finished ones green, the running server blue); one is
# minimized into the job grid, and 4 s later a click there brings it
# back in. Recorded by make.sh.
/resize 1200 760
/wait 800
/click 600 686
/move 700 720
/pace 250
/record start @FRAMES@ 20
/wait 500
/slow make
/key enter
/wait 700
/slow git log --oneline
/key enter
/wait 700
/slow python3 -m http.server 8000
/key enter
/wait 1200
# Minimize #2 (git log, bottom left).
/glide 520 354 600
/click 520 354
/wait 4000
# Bring it back from the job grid.
/glide 1110 130 600
/click 1110 130
/wait 1800
/record stop
/quit
