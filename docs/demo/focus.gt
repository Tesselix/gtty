# The focus chip: folders where the user ran commands lately, the newest
# at the bottom (setup.sh seeds them). Only looking around (cd, ls) doesn't
# count: ~/Downloads doesn't show up. Typing filters; Enter cds there.
/resize 1200 760
/s
/wait 1800
/type clear
/wait 500
/move 600 400
/wait 300
/pace 250
/record start @FRAMES@ 20
/wait 300
/slow cd ~/Downloads
/key enter
/wait 300
/slow ls
/key enter
/wait 700
/glide 300 644 600
/click 300 644
/wait 1500
/slow han
/wait 800
/key enter
/wait 1600
/record stop
/quit
